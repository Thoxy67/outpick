# Copy to .build/tv.env (.build/ is ignored by git) and keep one block uncommented; tools/deploy.sh reads it.
# An argument (tools/deploy.sh 192.168.1.85) still wins over TV=.

# LG OLED C1, webOS 6 (rooted): its host key is pinned under its IP, whatever name is used.
TV=192.168.1.174
SSH_OPTS="-o HostKeyAlias=192.168.1.174"

# LG QNED86, webOS 25 (rooted): key-only ssh, never fall back to a password prompt.
# TV=192.168.1.85
# SSH_OPTS="-o BatchMode=yes"
